# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais

# Neon PostgreSQL (formato: postgresql://user:pass@host/db?sslmode=verify-full)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/prdgra?sslmode=verify-full

# JWT — gere com: openssl rand -base64 64
JWT_SECRET=sua-chave-jwt-super-secreta-minimo-32-caracteres

# URL pública da API (usado pelo Next.js no browser)
NEXT_PUBLIC_API_URL=https://seudominio.com/api

# Origens permitidas pelo CORS do backend (separadas por vírgula se mais de uma)
CORS_ALLOWED_ORIGINS=https://seudominio.com

# Domínio para o Nginx/Certbot
DOMAIN=seudominio.com
