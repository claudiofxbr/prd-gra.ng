# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais

# Neon PostgreSQL (formato: postgresql://user:pass@host/db?sslmode=verify-full)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/prdgra?sslmode=verify-full

# JWT — gere com: openssl rand -base64 64
JWT_SECRET=sua-chave-jwt-super-secreta-minimo-32-caracteres

# URL pública da API (usado pelo Next.js no browser)
# Use caminho relativo /api quando o nginx servir tudo no mesmo dominio
NEXT_PUBLIC_API_URL=/api

# Origens permitidas pelo CORS do backend (separadas por vírgula se mais de uma)
# Inclua o dominio sem sub-path (o sub-path /prd-gra.ng nao faz parte da origem HTTP)
CORS_ALLOWED_ORIGINS=https://seudominio.com

# Domínio para o Nginx/Certbot
DOMAIN=seudominio.com

# IP do proxy reverso confiável para leitura de X-Forwarded-For (rate limit)
# Em Docker com nginx no mesmo compose: descubra com:
#   docker inspect <nginx-container-name> | grep '"IPAddress"'
# Normalmente será algo como 172.18.0.x ou 172.19.0.x
# Em produção sem Docker (nginx no host): 127.0.0.1
TRUSTED_PROXY_IP=127.0.0.1
