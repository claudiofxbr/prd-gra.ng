# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

set -e

findBaseDir () {
    WDIR="$1"
    while [ ! -d "$WDIR"/.mvn ] ; do
        cd ..
        WDIR=$(pwd)
        if [ "$WDIR" = "/" ] ; then
            break
        fi
    done
    BASE_DIR="$WDIR"
}

findBaseDir "$(pwd)"

WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain
DOWNLOAD_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"

if [ -r "$BASE_DIR/.mvn/wrapper/maven-wrapper.properties" ]; then
    while IFS= read -r line; do
        case "$line" in
            wrapperUrl=*) DOWNLOAD_URL="${line#wrapperUrl=}" ;;
        esac
    done < "$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"
fi

if [ -r "$WRAPPER_JAR" ]; then
    :
elif [ -n "$MVNW_REPOURL" ]; then
    wrapperUrl="$MVNW_REPOURL/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
    while IFS= read -r line; do
        case "$line" in
            wrapperUrl=*) wrapperUrl="${line#wrapperUrl=}" ;;
        esac
    done < "$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"
    echo "Downloading from: $wrapperUrl"
    if command -v wget > /dev/null; then
        QUIET="--quiet"
        [ "$MVNW_VERBOSE" = true ] && QUIET=""
        wget $QUIET "$wrapperUrl" -O "$WRAPPER_JAR" || rm -f "$WRAPPER_JAR"
    elif command -v curl > /dev/null; then
        QUIET="--silent"
        [ "$MVNW_VERBOSE" = true ] && QUIET="--progress-bar"
        curl -fsSL -o "$WRAPPER_JAR" "$wrapperUrl" || rm -f "$WRAPPER_JAR"
    fi
else
    echo "Downloading from: $DOWNLOAD_URL"
    if command -v wget > /dev/null; then
        QUIET="--quiet"
        [ "$MVNW_VERBOSE" = true ] && QUIET=""
        wget $QUIET "$DOWNLOAD_URL" -O "$WRAPPER_JAR" || rm -f "$WRAPPER_JAR"
    elif command -v curl > /dev/null; then
        QUIET="--silent"
        [ "$MVNW_VERBOSE" = true ] && QUIET="--progress-bar"
        curl -fsSL -o "$WRAPPER_JAR" "$DOWNLOAD_URL" || rm -f "$WRAPPER_JAR"
    fi
fi

exec "$JAVA_HOME/bin/java" \
    $MAVEN_OPTS \
    -classpath "$WRAPPER_JAR" \
    "-Dmaven.multiModuleProjectDirectory=$BASE_DIR" \
    $MAVEN_DEBUG_OPTS \
    $WRAPPER_LAUNCHER "$@"
